{
  "name": "Bubblegum",
  "description": "A fun, vibrant theme with playful pink and pastel colors",
  "typography": {
    "base": {
      "fontFamily": "Poppins",
      "letterSpacing": 0,
      "lineHeight": 1.6
    },
    "headline": {
      "fontFamily": "Poppins",
      "letterSpacing": 0,
      "lineHeight": 1.3
    }
  },
  "colors": {
    "dark": {
      "base": "#1a1325",
      "primary": "#fbe2a7",
      "info": "#8acfd1",
      "success": "#22c55e",
      "warning": "#fbe2a7",
      "danger": "#f96f70",
      "topbar": {
        "background": "#2a1f3d",
        "text": "#f6e6ee"
      },
      "card": {
        "background": "#2a1f3d",
        "text": "#f6e6ee"
      },
      "sidebar": {
        "background": "#1d1025",
        "text": "#f6e6ee",
        "primaryBackground": "#ec4899",
        "primaryText": "#ffffff",
        "accentBackground": "#f9a8d4",
        "accentText": "#2a1f3d"
      },
      "shadow": "#0f0a1680"
    },
    "light": {
      "base": "#f6e6ee",
      "primary": "#d04f99",
      "info": "#8acfd1",
      "success": "#22c55e",
      "warning": "#fbe2a7",
      "danger": "#f96f70",
      "card": {
        "background": "#fdedc9",
        "text": "#5b5b5b"
      },
      "topbar": {
        "background": "#fdedc9",
        "text": "#5b5b5b"
      },
      "sidebar": {
        "background": "#f8d8ea",
        "text": "#333333",
        "primaryBackground": "#ec4899",
        "primaryText": "#ffffff",
        "accentBackground": "#f9a8d4",
        "accentText": "#333333"
      },
      "shadow": "#d04f9980"
    }
  },
  "layout": {
    "spacing": 0.25,
    "rounding": 0.2,
    "circularRounding": 5,
    "shadow": {
      "offsetX": 0.4,
      "offsetY": 0.4,
      "blur": 0,
      "spread": 0
    }
  }
}

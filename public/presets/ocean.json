{
  "name": "Ocean",
  "description": "A calm, ocean-inspired theme with blue and teal accents",
  "typography": {
    "base": {
      "fontFamily": "Inter",
      "letterSpacing": 0,
      "lineHeight": 1.65
    },
    "headline": {
      "fontFamily": "Inter",
      "letterSpacing": -0.01,
      "lineHeight": 1.25
    }
  },
  "colors": {
    "dark": {
      "base": "#0c1721",
      "primary": "#0ea5e9",
      "info": "#06b6d4",
      "success": "#14b8a6",
      "warning": "#f59e0b",
      "danger": "#f97316",
      "topbar": {
        "background": "#1e293b",
        "text": "#e2e8f0"
      },
      "card": {
        "background": "#1e293b",
        "text": "#e2e8f0"
      },
      "sidebar": {
        "background": "#0c1721",
        "text": "#94a3b8",
        "primaryBackground": "#0ea5e9",
        "primaryText": "#ffffff",
        "accentBackground": "#14b8a6",
        "accentText": "#ffffff"
      },
      "shadow": "#000000bb"
    },
    "light": {
      "base": "#f8fafc",
      "primary": "#0ea5e9",
      "info": "#06b6d4",
      "success": "#14b8a6",
      "warning": "#f59e0b",
      "danger": "#f97316",
      "card": {
        "background": "#ffffff",
        "text": "#0f172a"
      },
      "topbar": {
        "background": "#ffffff",
        "text": "#0f172a"
      },
      "sidebar": {
        "background": "#f1f5f9",
        "text": "#334155",
        "primaryBackground": "#0ea5e9",
        "primaryText": "#ffffff",
        "accentBackground": "#14b8a6",
        "accentText": "#ffffff"
      },
      "shadow": "#0ea5e922"
    }
  },
  "layout": {
    "spacing": 0.25,
    "rounding": 0.5,
    "circularRounding": 6,
    "shadow": {
      "offsetX": 0,
      "offsetY": 2,
      "blur": 4,
      "spread": 0
    }
  }
}
